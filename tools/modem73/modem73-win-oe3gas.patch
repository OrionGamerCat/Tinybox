diff -ruN -x '*.exe' -x .git -x pdcurses -x hidapi modem73/net_compat.hh port/net_compat.hh
--- modem73/net_compat.hh	1970-01-01 01:00:00.000000000 +0100
+++ port/net_compat.hh	2026-11-01 21:26:43.472809037 +0100
@@ -0,0 +1,146 @@
+// net_compat.hh - POSIX socket/file shims so upstream modem73 builds on Windows
+// (MinGW-w64). On Linux/macOS it only pulls in the usual POSIX headers.
+#pragma once
+
+#ifdef _WIN32
+#ifndef _WIN32_WINNT
+#define _WIN32_WINNT 0x0601          // Windows 7+: WSAPoll, inet_pton
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <windows.h>
+#include <io.h>
+#include <direct.h>
+#include <sys/stat.h>
+#include <cerrno>
+#include <ctime>
+#include <cstdlib>
+#include <string>
+#include <unistd.h>
+// windows.h macros that clash with aicodix template parameters
+#undef IN
+#undef OUT
+#undef ERROR
+
+#ifndef MSG_NOSIGNAL
+#define MSG_NOSIGNAL 0
+#endif
+#ifndef MSG_DONTWAIT
+#define MSG_DONTWAIT 0x40000000      // handled in m73_recv/m73_send below
+#endif
+#ifndef F_GETFL
+#define F_GETFL 3
+#endif
+#ifndef F_SETFL
+#define F_SETFL 4
+#endif
+#ifndef O_NONBLOCK
+#define O_NONBLOCK 0x4000
+#endif
+#ifndef EINPROGRESS
+#define EINPROGRESS 112
+#endif
+
+// Winsock reports through WSAGetLastError, upstream checks errno
+inline void m73_wsa_errno() {
+    int e = WSAGetLastError();
+    errno = (e == WSAEWOULDBLOCK) ? EWOULDBLOCK
+          : (e == WSAEINPROGRESS) ? EINPROGRESS
+          : (e == WSAEINTR) ? EINTR : EIO;
+}
+inline bool m73_readable_now(int fd) {
+    WSAPOLLFD p{}; p.fd = (SOCKET)fd; p.events = POLLRDNORM;
+    return WSAPoll(&p, 1, 0) > 0;
+}
+inline ssize_t m73_recv(int fd, void* buf, size_t len, int flags) {
+    if ((flags & MSG_DONTWAIT) && !m73_readable_now(fd)) { errno = EWOULDBLOCK; return -1; }
+    int n = ::recv((SOCKET)fd, (char*)buf, (int)len, flags & ~(MSG_DONTWAIT | MSG_NOSIGNAL));
+    if (n < 0) m73_wsa_errno();
+    return n;
+}
+inline ssize_t m73_send(int fd, const void* buf, size_t len, int flags) {
+    int n = ::send((SOCKET)fd, (const char*)buf, (int)len, flags & ~(MSG_DONTWAIT | MSG_NOSIGNAL));
+    if (n < 0) m73_wsa_errno();
+    return n;
+}
+inline int m73_connect(int fd, const sockaddr* a, int alen) {
+    int r = ::connect((SOCKET)fd, a, alen);
+    if (r < 0) { m73_wsa_errno(); if (errno == EWOULDBLOCK) errno = EINPROGRESS; }
+    return r;
+}
+inline int m73_accept(int fd, sockaddr* a, socklen_t* alen) {
+    SOCKET s = ::accept((SOCKET)fd, a, alen);
+    if (s == INVALID_SOCKET) { m73_wsa_errno(); return -1; }
+    return (int)s;
+}
+inline int m73_socket(int af, int type, int proto) {
+    SOCKET s = ::socket(af, type, proto);
+    return s == INVALID_SOCKET ? -1 : (int)s;
+}
+// fcntl() is only used on sockets in the network code: O_NONBLOCK on/off
+inline int m73_fcntl(int fd, int cmd, int flags = 0) {
+    if (cmd == F_GETFL) return 0;
+    u_long nb = (flags & O_NONBLOCK) ? 1 : 0;
+    return ioctlsocket((SOCKET)fd, FIONBIO, &nb) == 0 ? 0 : -1;
+}
+inline int m73_setsockopt(int fd, int lvl, int name, const void* v, socklen_t l) {
+    // SO_REUSEADDR on Windows lets two programs share a port - use exclusive use
+    if (lvl == SOL_SOCKET && name == SO_REUSEADDR) name = SO_EXCLUSIVEADDRUSE;
+    return ::setsockopt((SOCKET)fd, lvl, name, (const char*)v, l);
+}
+inline int m73_poll(WSAPOLLFD* p, unsigned long n, int ms) { return WSAPoll(p, n, ms); }
+inline int sock_close(int fd) { return closesocket((SOCKET)fd); }
+inline int m73_getsockopt(int fd, int lvl, int name, void* v, socklen_t* l) {
+    return ::getsockopt((SOCKET)fd, lvl, name, (char*)v, l);
+}
+inline struct tm* localtime_r(const time_t* t, struct tm* out) {
+    return localtime_s(out, t) == 0 ? out : nullptr;
+}
+inline int m73_mkdir(const char* p, int) { return _mkdir(p); }
+
+// config dir: %APPDATA% stands in for $HOME (".config/modem73" below it)
+inline const char* m73_home() {
+    const char* h = std::getenv("APPDATA");
+    return h ? h : std::getenv("USERPROFILE");
+}
+
+struct M73WinsockInit {
+    M73WinsockInit() { WSADATA d; WSAStartup(MAKEWORD(2, 2), &d); }
+    ~M73WinsockInit() { WSACleanup(); }
+};
+inline M73WinsockInit m73_winsock_init_;
+
+#define recv(...)       m73_recv(__VA_ARGS__)
+#define send(...)       m73_send(__VA_ARGS__)
+#define connect(...)    m73_connect(__VA_ARGS__)
+#define accept(...)     m73_accept(__VA_ARGS__)
+#define socket(...)     m73_socket(__VA_ARGS__)
+#define fcntl(...)      m73_fcntl(__VA_ARGS__)
+#define setsockopt(...) m73_setsockopt(__VA_ARGS__)
+#define getsockopt(...) m73_getsockopt(__VA_ARGS__)
+#define poll(...)       m73_poll(__VA_ARGS__)
+#define mkdir(p, m)     m73_mkdir(p, m)
+
+#else  // POSIX
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <arpa/inet.h>
+#include <netdb.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <cstdlib>
+#ifndef MSG_NOSIGNAL
+#define MSG_NOSIGNAL 0
+#endif
+inline int sock_close(int fd) { return ::close(fd); }
+inline const char* m73_home() { return std::getenv("HOME"); }
+#endif
